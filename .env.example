# =============================================================================
# AAA - Your IELTS Journey
# Environment Variables Configuration Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Google Gemini API Configuration (Real AI Assessment for Writing & Speaking)
# -----------------------------------------------------------------------------
# Required for real AI grading of IELTS Writing Task 2 and Speaking audio recordings.
# Kept strictly server-side (DO NOT use NEXT_PUBLIC_ prefix).
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Fallback: GOOGLE_API_KEY or GOOGLE_GENAI_API_KEY are also recognized automatically
# GOOGLE_API_KEY=your-google-api-key

# Optional: Override Gemini Model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Supabase Configuration (Database & Storage - Optional for Cloud Sync)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
