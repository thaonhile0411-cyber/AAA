# Safe to expose to browser code. Copy these names to .env.local and replace
# the placeholders with values from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server only: required only for trusted Route Handlers that grade placement
# tests, seed/administer content, or generate roadmaps. Never prefix with
# NEXT_PUBLIC_, commit it, log it, or expose it to browser code.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Use the same origin for local navigation and OAuth callbacks.
AUTH_SITE_URL=http://localhost:3000

# Server only: enables optional AI feedback in the Placement Test.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash
