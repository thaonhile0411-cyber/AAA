# Safe to expose to browser code. Copy these names to .env.local and replace
# the placeholders with values from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server only: required only for trusted Route Handlers that grade placement
# tests, seed/administer content, or generate roadmaps. Never prefix with
# NEXT_PUBLIC_, commit it, log it, or expose it to browser code.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional: set these once the team's US-103 and roadmap pages exist.
# Until then, US-102 shows its handoff status on the survey page.
AAA_PLACEMENT_PATH=
AAA_ROADMAP_PATH=
